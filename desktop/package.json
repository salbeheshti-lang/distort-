{
  "name": "distort-desktop",
  "version": "1.0.32",
  "description": "DISTORT — Freedom Beyond Borders. A 100% free, anti-censorship VPN stronger than Nekoray & Hiddify.",
  "main": "dist/main.js",
  "author": "DISTORT Project",
  "license": "MIT",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build:next": "cd .. && bun run build",
    "build:desktop": "tsc -p tsconfig.json",
    "dist": "bun run build:desktop && electron-builder --win nsis",
    "dist:portable": "bun run build:desktop && electron-builder --win portable",
    "dist:all": "bun run build:desktop && electron-builder --win nsis --win portable",
    "pack": "electron-builder --dir",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.distort.desktop",
    "productName": "DISTORT",
    "copyright": "Copyright © 2026 DISTORT Project",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "salbeheshti-lang",
      "repo": "distort-"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.next/standalone",
        "to": "next-standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.next/static",
        "to": "next-standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../public",
        "to": "next-standalone/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DISTORT-Setup-${version}.${ext}",
      "publisherName": "DISTORT Project",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DISTORT",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "DISTORT-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    }
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "node-fetch": "^3.3.2",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
